# syntax=docker/dockerfile:1

ARG BASE_IMAGE=gcr.io/distroless/static-debian13:nonroot

# Runtime deps are assembled in an apt-enabled stage, then copied into the
# distroless base so downstream Arcane builds do not need extra runtime deps.
FROM debian:trixie-slim AS runtime-deps

RUN set -eu; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        curl \
        gzip \
        libdrm2 \
        tar; \
    mkdir -p /runtime-root; \
    normalize_dest_path() ( \
        path="$1"; \
        case "${path}" in \
            /bin) printf '%s\n' /usr/bin ;; \
            /bin/*) printf '/usr/bin/%s\n' "${path#/bin/}" ;; \
            /sbin) printf '%s\n' /usr/sbin ;; \
            /sbin/*) printf '/usr/sbin/%s\n' "${path#/sbin/}" ;; \
            /lib) printf '%s\n' /usr/lib ;; \
            /lib/*) printf '/usr/lib/%s\n' "${path#/lib/}" ;; \
            /lib64) printf '%s\n' /usr/lib64 ;; \
            /lib64/*) printf '/usr/lib64/%s\n' "${path#/lib64/}" ;; \
            *) printf '%s\n' "${path}" ;; \
        esac; \
    ); \
    copy_path() ( \
        path="$1"; \
        if [ ! -e "${path}" ]; then \
            printf 'Missing runtime file: %s\n' "${path}" >&2; \
            exit 1; \
        fi; \
        dest_path="$(normalize_dest_path "${path}")"; \
        mkdir -p "/runtime-root$(dirname "${dest_path}")"; \
        cp -aL "${path}" "/runtime-root${dest_path}"; \
    ); \
    for binary in /usr/bin/curl /usr/bin/tar /usr/bin/gzip; do \
        copy_path "${binary}"; \
        ldd "${binary}" > /tmp/runtime-ldd; \
        if grep -q 'not found' /tmp/runtime-ldd; then \
            cat /tmp/runtime-ldd >&2; \
            exit 1; \
        fi; \
        awk '/=> \// { print $3 } /^[[:space:]]*\// { print $1 }' \
            /tmp/runtime-ldd > /tmp/runtime-libs; \
        while IFS= read -r lib; do copy_path "${lib}"; done < /tmp/runtime-libs; \
    done; \
    for package in libc6 libdrm2; do \
        dpkg-query -L "${package}" > /tmp/runtime-package-files; \
        while IFS= read -r path; do \
            if [ -f "${path}" ] || [ -L "${path}" ]; then \
                copy_path "${path}"; \
            fi; \
        done < /tmp/runtime-package-files; \
    done

FROM ${BASE_IMAGE}

COPY --from=runtime-deps /runtime-root/ /
