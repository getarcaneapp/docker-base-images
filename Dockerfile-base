# syntax=docker/dockerfile:1

ARG DHI_BASE_IMAGE=dhi.io/debian-base:trixie

# Runtime deps are assembled in an apt-enabled stage, then copied into the
# DHI base so downstream Arcane builds do not need dhi.io credentials.
FROM debian:trixie-slim AS runtime-deps

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gzip \
        libdrm2 \
        tar \
        tzdata \
    && mkdir -p /runtime-root \
    && normalize_dest_path() { \
        path="$1"; \
        case "${path}" in \
            /bin) printf '%s\n' /usr/bin ;; \
            /bin/*) printf '/usr/bin/%s\n' "${path#/bin/}" ;; \
            /sbin) printf '%s\n' /usr/sbin ;; \
            /sbin/*) printf '/usr/sbin/%s\n' "${path#/sbin/}" ;; \
            /lib) printf '%s\n' /usr/lib ;; \
            /lib/*) printf '/usr/lib/%s\n' "${path#/lib/}" ;; \
            *) printf '%s\n' "${path}" ;; \
        esac; \
    } \
    && copy_path() { \
        path="$1"; \
        if [ -e "${path}" ]; then \
            dest_path="$(normalize_dest_path "${path}")"; \
            mkdir -p "/runtime-root$(dirname "${dest_path}")"; \
            cp -aL "${path}" "/runtime-root${dest_path}"; \
        fi; \
    } \
    && copy_tree() { \
        path="$1"; \
        if [ -e "${path}" ]; then \
            dest_path="$(normalize_dest_path "${path}")"; \
            mkdir -p "/runtime-root$(dirname "${dest_path}")"; \
            cp -a "${path}" "/runtime-root${dest_path}"; \
        fi; \
    } \
    && runtime_bins="/usr/bin/curl /usr/bin/tar /usr/bin/gzip" \
    && for bin in ${runtime_bins}; do \
        copy_path "${bin}"; \
        ldd "${bin}" \
            | awk '/=> \// { print $3 } /^\// { print $1 }' \
            | sort -u \
            | while read -r lib; do copy_path "${lib}"; done; \
    done \
    && dpkg-query -L libdrm2 \
        | while read -r path; do \
            if [ -f "${path}" ] || [ -L "${path}" ]; then \
                copy_path "${path}"; \
            fi; \
        done \
    && copy_tree /etc/ssl/certs \
    && copy_tree /usr/share/ca-certificates \
    && copy_tree /usr/share/zoneinfo \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

FROM ${DHI_BASE_IMAGE}

COPY --from=runtime-deps /runtime-root/ /