# syntax=docker/dockerfile:1

FROM dhi.io/node:25-dev

RUN apt-get update \
	&& apt-get install -y --no-install-recommends jq \
	&& apt-get clean \
	&& rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

LABEL org.opencontainers.image.title="Arcane Node Build"
LABEL org.opencontainers.image.description="Arcane build image with dhi node-dev toolchain"
LABEL org.opencontainers.image.source="https://github.com/getarcaneapp/arcane"
